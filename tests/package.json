{
  "name": "cineverse-rules-tests",
  "private": true,
  "type": "module",
  "description": "Firestore security-rule tests. Kept out of the repo root so the Cloudflare build never sees a package.json and tries to install anything.",
  "scripts": {
    "test": "firebase emulators:exec --config ../firebase.json --project cineverse-rules-test --only firestore \"node --test rules.test.mjs\"",
    "emulator": "firebase emulators:start --config ../firebase.json --project cineverse-rules-test --only firestore",
    "coverage": "node coverage.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase-tools": "^13.29.1"
  }
}
