rules_version = '2';

// CineVerse Firestore security rules.
//
// Publish these in Firebase Console -> Firestore Database -> Rules -> Publish.
// Sharing a list will NOT work until they are published, because a friend has to
// be able to read the owner's shared snapshot.
//
// The rule that matters: raw user data (watchlist, ratings, watched, lists) is
// owner-only. The ONLY cross-user readable thing is users/{uid}/shared/{doc} —
// derived snapshots the owner explicitly publishes: the taste profile used by the
// watch-party matcher, and any list the owner chose to share.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ---- Per-user data ----
    match /users/{uid} {
      // The user's own profile doc (avatar, created).
      allow read, write: if isOwner(uid);

      // Derived, deliberately shareable documents:
      //   shared/taste        -> friend taste profile (js/social.js getFriendTaste)
      //   shared/list_{listId} -> a shared list snapshot (js/lists.js shareList)
      // Readable by any signed-in user; only ever written by the owner.
      match /shared/{docId} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }

      // Everything else under a user is private to that user.
      match /watchlist/{docId} { allow read, write: if isOwner(uid); }
      match /watched/{docId}   { allow read, write: if isOwner(uid); }
      match /ratings/{docId}   { allow read, write: if isOwner(uid); }
      match /lists/{docId}     { allow read, write: if isOwner(uid); }
      // Per-episode TV progress (js/episodes.js), one document per show.
      match /progress/{docId}  { allow read, write: if isOwner(uid); }
      // Optional exact playback positions for currently-watching movies.
      match /movieProgress/{docId} { allow read, write: if isOwner(uid); }
    }

    // ---- Friend discovery ----
    // Name/code/avatar only — this is what "add a friend by code" searches.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid);
    }

    // email -> uid lookup, so a friend can be added by email address.
    match /emailIndex/{emailKey} {
      allow read: if signedIn();
      // Only the owner of that uid may claim/point an entry at themselves.
      allow write: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    // ---- Friend graph ----
    match /friendRequests/{reqId} {
      // Visible to the two people involved (queries filter on from/to).
      allow read: if signedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      // You can only send a request as yourself.
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      // Either party may resolve it (accept/decline/cancel).
      allow update, delete: if signedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // ---- Collaborative lists ----
    // A list two or more people both add to. Unlike users/{uid}/shared/{doc} —
    // which is a snapshot the owner publishes and everyone else can only read —
    // every member of one of these can write to it.
    //
    // The list document itself is readable by any signed-in user, because that is
    // what makes an invite link work: you have to be able to see a list's name
    // before you can decide to join it. Its ITEMS are members-only, so a link
    // reveals nothing but a title until you actually join. Ids are 20 random
    // characters, so "readable if you have the link" is the real access control
    // here, exactly as it is for a shared snapshot.
    function collabMembers(listId) {
      return get(/databases/$(database)/documents/collabLists/$(listId)).data.members;
    }
    function isCollabMember(listId) {
      return request.auth != null && request.auth.uid in collabMembers(listId);
    }

    match /collabLists/{listId} {
      allow read: if signedIn();

      // You can only create a list you are yourself a member of.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 12;

      // Two shapes of update are allowed, and nothing else:
      //   1. a member editing the list (rename, re-icon, touch updatedAt) —
      //      and a member may never write themselves out of the member list
      //      except by leaving, which is case 2 in reverse;
      //   2. a signed-in visitor adding ONLY themselves, which is joining.
      allow update: if signedIn() && (
        (request.auth.uid in resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.members.size() <= 12)
        ||
        (!(request.auth.uid in resource.data.members)
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.name == resource.data.name
          && request.resource.data.members.size() <= 12)
      );

      // Only whoever made it can destroy it for everybody. Anyone else leaves
      // instead, which is an update.
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /items/{itemId} {
        allow read: if isCollabMember(listId);
        // A member adds titles as themselves — the credit on each row has to be
        // true, or "who added this" means nothing.
        allow create: if isCollabMember(listId) && request.resource.data.addedBy == request.auth.uid;
        allow update: if isCollabMember(listId) && request.resource.data.addedBy == resource.data.addedBy;
        // Any member can remove any title. It is a shared list; policing who may
        // remove what would make it a worse one.
        allow delete: if isCollabMember(listId);
      }
    }

    match /friendships/{pairId} {
      // Members only — read (array-contains query), unfriend (delete), and the
      // accepting user's create.
      allow read, update, delete: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
    }
  }
}
